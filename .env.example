# Copy to .env on the deploy host and fill in real values. .env is gitignored.

# Discord bot token (required)
WL8v8_BOT_TOKEN=

# Discord IDs (optional, fall back to hardcoded defaults in DiscordConfig.cs if unset)
WL_DISCORD_GUILD_ID=
WL_DISCORD_DRAFT_CHANNEL_ID=
WL_DISCORD_TEAM1_ROLE_ID=
WL_DISCORD_TEAM2_ROLE_ID=

# Optional: restrict all commands to a single channel (0 / unset = no restriction)
WL_DISCORD_COMMAND_CHANNEL_ID=

# Optional: channel for replay uploads (Phase 1.5, not yet implemented)
WL_DISCORD_REPLAY_CHANNEL_ID=
